{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "8 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* 0-5 * * *"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "prPriority": 10
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "automerge": true
    },
    {
      "description": "Generated gRPC code rejects a grpcio older than the grpcio-tools that generated it",
      "matchPackageNames": ["grpcio", "grpcio-tools"],
      "groupName": "grpcio",
      "groupSlug": "grpcio"
    },
    {
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "minimumReleaseAge": "0 days",
      "automerge": true
    },
    {
      "matchManagers": ["helm-values"],
      "matchPackageNames": ["ghcr.io/workfloworchestrator/supa"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["python"],
      "enabled": false
    }
  ],
  "timezone": "Europe/Amsterdam"
}
